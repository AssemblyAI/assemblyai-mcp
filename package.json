{
  "name": "assemblyai-mcp",
  "version": "0.1.0",
  "description": "MCP server wrapping AssemblyAI transcription, Speech Understanding, and Guardrails",
  "type": "module",
  "engines": {
    "node": "24.15.0"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "test": "tsx src/smoke-test.ts && tsx src/tts-test.ts && tsx src/oauth-test.ts",
    "test:live": "tsx src/live-test.ts",
    "test:oauth": "tsx src/oauth-preview-test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@vercel/oidc": "4.0.1",
    "mcp-handler": "1.1.0",
    "next": "16.4.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "@types/react": "19.2.14",
    "tsx": "4.23.15",
    "typescript": "6.0.2"
  },
  "overrides": {
    "mcp-handler": {
      "@modelcontextprotocol/sdk": "$@modelcontextprotocol/sdk"
    },
    "zod": "$zod",
    "@hono/node-server": "2.1.5"
  }
}
